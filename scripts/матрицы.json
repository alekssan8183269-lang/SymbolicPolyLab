{
  "name": "Сжатие больших матриц через SVD 📊",
  "level": "university",
  "help_text": "Скрипт генерирует большую матрицу, выполняет сингулярное разложение (SVD) и визуализирует потерю качества при уменьшении ранга матрицы.",
  "code": [
    "import numpy as np",
    "import matplotlib.pyplot as plt",
    "",
    "# 1. Генерируем большую матрицу (500x500 элементов)",
    "np.random.seed(42)",
    "matrix_size = 500",
    "base_matrix = np.random.randn(matrix_size, matrix_size)",
    "",
    "# 2. Выполняем сингулярное разложение (SVD)",
    "U, S, Vt = np.linalg.svd(base_matrix, full_matrices=False)",
    "",
    "# 3. Восстанавливаем матрицу, используя только топ-20 сингулярных чисел (сжатие)",
    "k = 20",
    "compressed_matrix = np.dot(U[:, :k] * S[:k], Vt[:k, :])",
    "",
    "# 4. Считаем ошибку сжатия (норму Фробениуса)",
    "error = np.linalg.norm(base_matrix - compressed_matrix)",
    "print(f'Размер матрицы: {matrix_size}x{matrix_size}')",
    "print(f'Использовано компонент: {k}')",
    "print(f'Ошибка приближения: {error:.2f}')",
    "",
    "# 5. Визуализация",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 6))",
    "",
    "ax1 = axes[0]",
    "im1 = ax1.imshow(base_matrix, cmap='viridis')",
    "ax1.set_title('Оригинальная большая матрица')",
    "fig.colorbar(im1, ax=ax1, fraction=0.046, pad=0.04)",
    "",
    "ax2 = axes[1]",
    "im2 = ax2.imshow(compressed_matrix, cmap='viridis')",
    "ax2.set_title(f'Сжатая матрица (Ранг k={k})')",
    "fig.colorbar(im2, ax=ax2, fraction=0.046, pad=0.04)",
    "",
    "plt.tight_layout()",
    "plt.show()"
  ]
}
