{
  "name": "Матричный анализ ортогональных полиномов 📊",
  "level": "university",
  "help_text": "Скрипт формирует матрицу коэффициентов для 20 полиномов Чебышёва (до 30-й степени), анализирует её структуру и визуализирует распределение корней и спектр полиномов.",
  "code": [
    "import numpy as np",
    "import matplotlib.pyplot as plt",
    "from scipy.special import chebyc",
    "",
    "# 1. Генерируем 20 полиномов Чебышёва высших степеней (до 30)",
    "num_polynomials = 20",
    "max_degree = 30",
    "matrix_coef = np.zeros((num_polynomials, max_degree + 1))",
    "",
    "# Заполняем матрицу: каждая строка — это коэффициенты одного полинома",
    "for i in range(num_polynomials):",
    "    degree = 10 + i  # Полиномы со степенями от 10 до 29",
    "    poly = np.polynomial.Chebyshev.basis(degree).convert(kind=np.polynomial.Polynomial)",
    "    coefs = poly.coef",
    "    matrix_coef[i, :len(coefs)] = coefs",
    "",
    "print(f'Сформирована матрица полиномов размерностью: {matrix_coef.shape}')",
    "print(f'Ранг полученной матрицы: {np.linalg.matrix_rank(matrix_coef)}')",
    "",
    "# 2. Настраиваем сетку для визуализации",
    "fig = plt.figure(figsize=(14, 6))",
    "",
    "# Левый график: Структура и веса коэффициентов в матрице",
    "ax1 = fig.add_subplot(121)",
    "im = ax1.imshow(np.log10(np.abs(matrix_coef) + 1e-15), cmap='plasma', aspect='auto')",
    "ax1.set_title('Логарифмическая структура матрицы коэффициентов')",
    "ax1.set_xlabel('Степень члена (X^k)')",
    "ax1.set_ylabel('Индекс полинома (T_n)')",
    "fig.colorbar(im, ax=ax1, label='Порядок величины (log10)')",
    "",
    "# Правый график: Отрисовка самих полиномов высокого порядка",
    "ax2 = fig.add_subplot(122)",
    "x = np.linspace(-1, 1, 400)",
    "for i in range(0, num_polynomials, 4):  # Шаг 4, чтобы график не сливался",
    "    degree = 10 + i",
    "    y = np.polynomial.Chebyshev.basis(degree)(x)",
    "    ax2.plot(x, y, label=f'T_{degree}(x)', linewidth=1.5)",
    "",
    "ax2.set_title('Визуализация ортогональных полиномов на [-1, 1]')",
    "ax2.set_xlabel('X')",
    "ax2.set_ylabel('T_n(x)')",
    "ax2.grid(True, linestyle='--', alpha=0.6)",
    "ax2.legend(loc='lower center', bbox_to_anchor=(0.5, -0.25), ncol=5)",
    "",
    "plt.tight_layout()",
    "plt.show()"
  ]
}
